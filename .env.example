NEXT_PUBLIC_SITE_URL=https://autocash.cz

# SMTP (Spacemail) — jen na serveru (Railway Variables). Nikdy NEXT_PUBLIC_*.
# Schránka zůstává info@docasnyvykup.cz; From display name je autocash.cz.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=info@docasnyvykup.cz
SMTP_PASS=
LEAD_NOTIFY_TO=info@docasnyvykup.cz
# Podepisování odkazu na wizard fotek (náhodný dlouhý řetězec). Bez něj poptávka projde, wizard ne.
PHOTO_TOKEN_SECRET=
# Stabilní tajný odkaz pro bratry (WhatsApp / SMS). Veřejná URL:
# https://autocash.cz/fotky/<PHOTO_WIZARD_SHARE_SECRET>
# Vygenerujte: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Min. 8 znaků, jen A–Z a–z 0–9 _ - (bez tečky). Rotace = změna env + redeploy.
PHOTO_WIZARD_SHARE_SECRET=
# Volitelně: bez ní inbox ukáže "autocash.cz" <SMTP_USER>
# MAIL_FROM="autocash.cz <info@docasnyvykup.cz>"

# Analytics (volitelné). NEXT_PUBLIC_* musí být nastavené před buildem.
NEXT_PUBLIC_GTM_ID=
# GA4 stream (production: G-DXBBY6TFGG). Direct gtag.js loads only when GTM is
# unset. Beside GTM, /qr fires qr_letak from a GTM-free iframe (official gtag
# stub queued before gtag/js). Do not unpause GTM tag GA4 - qr_letak.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GOOGLE_ADS_AW_ID=
# NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_SEND_TO=
